<ResourceDictionary
    x:Class="Crepusculum.NINA.SmartPlugControl.SmartPlugControlSequenceItems.SmartPlugControlSequenceItemsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Crepusculum.NINA.SmartPlugControl.SmartPlugControlSequenceItems"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!--  Same hand-drawn plug glyph used for the equipment page tab icon.  -->
    <GeometryGroup x:Key="Crepusculum.NINA.SmartPlugControl_SequenceItemSVG">
        <PathGeometry Figures="M2,9 L14,9 L14,19 L2,19 Z" />
        <PathGeometry Figures="M5,9 L7,9 L7,3 L5,3 Z" />
        <PathGeometry Figures="M9,9 L11,9 L11,3 L9,3 Z" />
    </GeometryGroup>

    <!--
        WPF resolves implicit DataTemplates (matched by DataType) up the class hierarchy, so this one
        template covers every PlugPickerInstructionBase subclass that doesn't need its own specific
        template (Turn Off Plug, Turn On/Off LED) - only TurnOnPlugInstruction (below) needs a more
        specific template, for its extra delay field; WPF prefers the exact-type match over this one.
    -->
    <DataTemplate DataType="{x:Type local:PlugPickerInstructionBase}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="Plug" />
                    <ComboBox
                        MinWidth="140"
                        ItemsSource="{Binding AvailablePlugs}"
                        SelectedItem="{Binding SelectedPlug}"
                        DisplayMemberPath="DisplayName" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:TurnOnPlugInstruction}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="Plug" />
                    <ComboBox
                        MinWidth="140"
                        Margin="0,0,10,0"
                        ItemsSource="{Binding AvailablePlugs}"
                        SelectedItem="{Binding SelectedPlug}"
                        DisplayMemberPath="DisplayName" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="Wait after turning on (s)" />
                    <TextBox MinWidth="40" Text="{Binding DelayAfterSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:TurnOnAllPlugsInstruction}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="Wait after turning on (s)" />
                    <TextBox MinWidth="40" Text="{Binding DelayAfterSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <!--  Covers both PlugIsOnCondition and PlugIsOffCondition (implicit template resolution up the class hierarchy).  -->
    <DataTemplate DataType="{x:Type local:PlugConditionBase}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="Plug" />
                    <ComboBox
                        MinWidth="140"
                        ItemsSource="{Binding AvailablePlugs}"
                        SelectedItem="{Binding SelectedPlug}"
                        DisplayMemberPath="DisplayName" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <!--  Covers both TotalConsumptionBelowCondition and TotalConsumptionAboveCondition.  -->
    <DataTemplate DataType="{x:Type local:ConsumptionThresholdConditionBase}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="Threshold (W)" />
                    <TextBox MinWidth="60" Text="{Binding ThresholdWatts, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <!--  Covers PlugStateChangedTrigger (currently the only PlugTriggerBase subclass).  -->
    <DataTemplate DataType="{x:Type local:PlugTriggerBase}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="Plug" />
                    <ComboBox
                        MinWidth="140"
                        ItemsSource="{Binding AvailablePlugs}"
                        SelectedItem="{Binding SelectedPlug}"
                        DisplayMemberPath="DisplayName" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
</ResourceDictionary>
