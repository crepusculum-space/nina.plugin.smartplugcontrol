<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Crepusculum.NINA.SmartPlugControl</RootNamespace>
    <AssemblyName>Crepusculum.NINA.SmartPlugControl</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--  NINA loads the plugin DLL directly from its own folder (not via a project/exe host that
          would pull dependencies along), so every NuGet dependency (TapoConnect, Newtonsoft.Json,
          etc.) must physically be copied to the output directory - Class Library projects don't do
          this by default the way Exe projects do.  -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!--  ExcludeAssets="runtime": compile against NINA's own assemblies (and everything they pull in,
          e.g. Newtonsoft.Json, Accord, EntityFramework...) without copying local duplicates of them -
          the host process already has them loaded. Only genuinely plugin-specific dependencies below
          (TapoConnect and its own transitive deps, ProtectedData) need to be physically copied.  -->
    <PackageReference Include="NINA.Plugin" Version="3.0.0.2017-beta" ExcludeAssets="runtime" />
    <PackageReference Include="TapoConnect" Version="3.2.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <PropertyGroup />
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="&#xD;&#xA;if not exist &quot;%25localappdata%25\NINA\Plugins\3.0.0&quot; (&#xD;&#xA;  echo &quot;Creating $(PlatformName) Plugins folder&quot;&#xD;&#xA;  mkdir &quot;%25localappdata%25\NINA\Plugins\3.0.0&quot;&#xD;&#xA;)&#xD;&#xA;if not exist &quot;%25localappdata%25\NINA\Plugins\3.0.0\$(TargetName)&quot; (&#xD;&#xA;  echo &quot;Creating $(PlatformName) Plugins $(TargetName) folder&quot;&#xD;&#xA;  mkdir &quot;%25localappdata%25\NINA\Plugins\3.0.0\$(TargetName)&quot;&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;echo &quot;Copying $(PlatformName) build output (including dependencies)&quot;&#xD;&#xA;xcopy &quot;$(TargetDir)*&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\$(TargetName)&quot; /h/i/c/k/e/r/y/s&#xD;&#xA;  " />
  </Target>
</Project>