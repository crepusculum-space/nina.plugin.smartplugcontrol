<ResourceDictionary
    x:Class="Crepusculum.NINA.SmartPlugControl.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  This data template will be displayed in N.I.N.A. on the options->plugin tab with the datacontext of the TestPlugin instance  -->
    <!--  In order for this datatemplate to be picked correctly, the key has to follow the naming convention of <IPlugin.Name>_Options -->
    <!--  Furthermore the Resource Dictionary has to be exported via code behind export attributes  -->
    <DataTemplate x:Key="Smart Plug Control_Options">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="TP-Link account" FontWeight="Bold" Margin="0,0,0,5" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Username/email" VerticalAlignment="Center" MinWidth="160" />
                <TextBox MinWidth="200" Text="{Binding TpLinkUsername, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Password" VerticalAlignment="Center" MinWidth="160" />
                <TextBox MinWidth="200" Text="{Binding TpLinkPassword, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Text="Consumption alerts (used once alert notifications are built)" FontWeight="Bold" Margin="0,0,0,5" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Max consumption threshold (W, 0 = disabled)" VerticalAlignment="Center" MinWidth="260" />
                <TextBox MinWidth="80" Text="{Binding MaxConsumptionThresholdWatts, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Preventive alert (% of max)" VerticalAlignment="Center" MinWidth="260" />
                <TextBox MinWidth="80" Text="{Binding PreventiveAlertPercent, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Text="LED behavior" FontWeight="Bold" Margin="0,0,0,5" />
            <CheckBox Content="Turn off all LEDs when a sequence starts" IsChecked="{Binding LedsOffAtSequenceStart}" Margin="0,0,0,5" />
            <CheckBox Content="Turn on all LEDs when a sequence finishes" IsChecked="{Binding LedsOnAtSequenceFinish}" Margin="0,0,0,15" />

            <TextBlock Text="Polling" FontWeight="Bold" Margin="0,0,0,5" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Equipment page refresh interval (s)" VerticalAlignment="Center" MinWidth="260" />
                <TextBox MinWidth="80" Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Text="Plugs on this account - only checked plugs show up in the equipment page and sequencer:" Margin="0,0,0,5" TextWrapping="Wrap" MaxWidth="500" />
            <Button Content="Refresh Plug List" Command="{Binding RefreshPlugsCommand}" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,5" />
            <DataGrid
                ItemsSource="{Binding AllPlugs}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                MaxHeight="300"
                MaxWidth="500"
                HorizontalAlignment="Left">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" IsReadOnly="True" Width="180" />
                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" IsReadOnly="True" Width="80" />
                    <DataGridCheckBoxColumn Header="Visible in NINA" Binding="{Binding IsVisibleInNina}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>